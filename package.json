{
  "name": "astramem-local",
  "version": "0.22.1",
  "description": "Local-first, encrypted memory daemon for AI coding agents â€” hybrid retrieval, provenance receipts, MCP tools, SQLCipher at rest",
  "keywords": [
    "mcp",
    "claude-code",
    "memory",
    "agent-memory",
    "rag",
    "local-first",
    "sqlite",
    "sqlite-vec",
    "embeddings",
    "ollama"
  ],
  "type": "module",
  "bin": {
    "astramem-local": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "bun.lock"
  ],
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -w -p .",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:eval": "tsc -p tsconfig.eval.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run tests/smoke",
    "test:soak": "vitest run --config vitest.soak.config.ts",
    "contracts:generate": "node contracts/generate-types.mjs && node contracts/generate-zod.mjs",
    "contracts:validate": "node contracts/validate.mjs",
    "contracts:build": "node contracts/generate-types.mjs && node contracts/generate-zod.mjs && node contracts/validate.mjs",
    "prepublishOnly": "bun run build",
    "eval:longmemeval:sample": "bun scripts/eval/longmemeval/sample.mts",
    "eval:longmemeval:smoke": "bun scripts/eval/longmemeval/run-smoke.mts",
    "eval:longmemeval:judge": "bun scripts/eval/longmemeval/judge.mts",
    "eval:locomo:sample": "bun scripts/eval/locomo/sample.mts",
    "eval:locomo:run": "bun scripts/eval/locomo/run.mts",
    "eval:locomo:judge": "bun scripts/eval/locomo/judge.mts",
    "eval:locomo:diagnose": "bun scripts/eval/locomo/diagnose-retrieval.mts",
    "eval:extraction-bench": "bun scripts/eval/extraction-bench/run-bench.mts",
    "perf:baseline": "bun scripts/perf/seed.mts && bun scripts/perf/bench.mts && node scripts/perf/fusion-profile.mts && bun scripts/perf/embed-cost.mts"
  },
  "engines": {
    "node": ">=22"
  },
  "trustedDependencies": [
    "@napi-rs/keyring",
    "better-sqlite3-multiple-ciphers",
    "onnxruntime-node",
    "protobufjs",
    "sharp"
  ],
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "fastify": "^5.9.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "sqlite-vec": "^0.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "json-schema-to-zod": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "zod": "^4.4.3",
    "adm-zip": "^0.6.0",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.4.0",
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.0",
    "sharp": "^0.35.0",
    "find-my-way": "^9.7.0",
    "postcss": "^8.5.18",
    "js-yaml": "^4.3.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astragenie/astramem-local.git"
  },
  "homepage": "https://github.com/astragenie/astramem-local#readme",
  "bugs": {
    "url": "https://github.com/astragenie/astramem-local/issues"
  }
}
