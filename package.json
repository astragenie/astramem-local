{
  "name": "astramem-local",
  "version": "0.11.0",
  "type": "module",
  "bin": {
    "astramem-local": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -w -p .",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run tests/smoke",
    "contracts:generate": "node contracts/generate-types.mjs && node contracts/generate-zod.mjs",
    "contracts:validate": "node contracts/validate.mjs",
    "contracts:build": "node contracts/generate-types.mjs && node contracts/generate-zod.mjs && node contracts/validate.mjs",
    "prepublishOnly": "bun run build",
    "eval:longmemeval:sample": "bun scripts/eval/longmemeval/sample.mts",
    "eval:longmemeval:smoke": "bun scripts/eval/longmemeval/run-smoke.mts",
    "eval:longmemeval:judge": "bun scripts/eval/longmemeval/judge.mts",
    "eval:locomo:sample": "bun scripts/eval/locomo/sample.mts",
    "eval:locomo:run": "bun scripts/eval/locomo/run.mts",
    "eval:locomo:judge": "bun scripts/eval/locomo/judge.mts",
    "eval:extraction-bench": "bun scripts/eval/extraction-bench/run-bench.mts",
    "perf:baseline": "bun scripts/perf/seed.mts && bun scripts/perf/bench.mts && node scripts/perf/fusion-profile.mts && bun scripts/perf/embed-cost.mts"
  },
  "engines": {
    "node": ">=22"
  },
  "trustedDependencies": [
    "@napi-rs/keyring",
    "better-sqlite3-multiple-ciphers"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "fastify": "^5.9.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "sqlite-vec": "^0.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "json-schema-to-zod": "^2.8.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astragenie/astramemory-local.git"
  },
  "homepage": "https://github.com/astragenie/astramemory-local#readme",
  "bugs": {
    "url": "https://github.com/astragenie/astramemory-local/issues"
  }
}
