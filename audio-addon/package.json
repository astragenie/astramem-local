{
  "name": "astramem-audio",
  "version": "0.2.0",
  "description": "Optional on-device whisper.cpp add-on for astramem-local's audio-file transcription capture (FEAT-489). Wraps the official ggml-org/whisper.cpp CPU-only CLI (bundled per-platform, v1: win32-x64 + linux-x64); GGML model downloaded + checksum-verified on first use. astramem-local's transcribe handler works with this package absent (add-on-not-installed is a handled, non-crashing state).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astragenie/astramem-local.git",
    "directory": "audio-addon"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "peerDependencies": {
    "astramem-local": ">=0.18.0"
  },
  "peerDependenciesMeta": {
    "astramem-local": {
      "optional": true
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "fetch-binaries:all": "node scripts/fetch-binaries.mjs --all",
    "fetch-model": "node scripts/fetch-model.mjs",
    "prepublishOnly": "node scripts/fetch-binaries.mjs --all && tsc -p ."
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
